# Smartys Downloader — Konfiguration (kopieren nach smartdl.env oder .env)

# Real-Debrid API-Key: https://real-debrid.com/apitoken
REALDEBRID_API_KEY=

# DebridLink API-Key: https://debrid-link.fr → Einstellungen → API
DEBRIDLINK_API_KEY=

# Optional: FlareSolverr für filecrypt.cc (docker run -d --name flaresolverr \
#   -p 8191:8191 --restart unless-stopped ghcr.io/flaresolverr/flaresolverr:latest)
FLARESOLVERR_URL=

# Optional: rsync-Ziel für fertige Filme (leer = nicht verschieben) — LEGACY
# Beispiel: user@media-pc:/media/filme/
JELLYFIN_TARGET=

# Kategorie-Ziele (leer = nur entpacken). Formate: user@host:/pfad/ oder /lokaler/pfad/
# Auch in der GUI einstellbar (Einstellungen → Nachbearbeitung).
MOVIE_TARGET=
SERIES_TARGET=
SOFTWARE_TARGET=
MUSIC_TARGET=
AUDIOBOOK_TARGET=
KIDS_TARGET=
OTHER_TARGET=

# Download-Ziel (leer = ~/Downloads/SmartDownloader)
DOWNLOAD_DIR=

# ===== Beschleunigung =====
# Multi-Segment: parallele Verbindungen pro Download (Default 8, 0 = auto).
# Range-fähige Server werden automatisch erkannt; ohne Range-Support fällt der
# Downloader auf Single-Stream zurück.
SEGMENTS=8

# ===== Torrent (aria2) =====
# aria2c muss installiert sein: sudo apt install aria2
ARIA2_RPC_PORT=6800
ARIA2_RPC_SECRET=

# ===== Reconnect (neue IP vom Router, für Direct-Hoster-Limits) =====
# Einer der drei Wege reicht (Reihenfolge: script → fritzbox → url).
# 1) Externes Skript (z. B. curl-Aufruf an die Router-WebUI):
RECONNECT_SCRIPT=
# 2) Fritz!Box (TR-064/UPnP ForceTermination):
RECONNECT_FRITZ_HOST=
RECONNECT_FRITZ_USER=
RECONNECT_FRITZ_PASS=
# 3) Einfache URL (GET = neue Verbindung):
RECONNECT_URL=
